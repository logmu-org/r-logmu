#!/bin/sh
# Generate src/Makevars with architecture-appropriate SIMD build rules.
set -e

: "${R_HOME=$(R RHOME)}"
if [ -z "${R_HOME}" ]; then
  echo "configure: cannot determine R_HOME" >&2
  exit 1
fi
RBIN="${R_HOME}/bin/R"

CXX=$("${RBIN}" CMD config CXX)

# Ask the compiler what it targets (arch macros are independent of -std).
#
# TWO WAYS OF ASKING, because one of them failed silently. Reading from stdin
# came back empty in the R-hub clang sanitizer container, and the empty answer
# fell through to ARCH=other -- so the AVX objects were not compiled while the
# headers still declared and referenced them, and the package would not load:
#
#     undefined symbol: _ZN4tier4avx210simd_lanesEv
#
# `-x c++ /dev/null` is the more portable spelling. The stdin form is kept as a
# fallback for a compiler that dislikes /dev/null.
DEFS=$(${CXX} -E -dM -x c++ /dev/null 2>/dev/null || true)
if [ -z "${DEFS}" ]; then
  DEFS=$(printf '' | ${CXX} -E -dM - 2>/dev/null || true)
fi

if [ -z "${DEFS}" ]; then
  echo "configure: WARNING: could not read target macros from the compiler." >&2
  echo "configure:          Compiler was: ${CXX}" >&2
  echo "configure:          Building the BASELINE kernel only -- no AVX2, no AVX-512." >&2
fi

ARCH=other
case " ${DEFS} " in
  *__x86_64__*|*__i386__*)  ARCH=x86 ;;
  *__aarch64__*|*__arm__*)  ARCH=arm ;;
esac

SIMD_OBJECTS=""
BUILD_SIMD_TIERS=0
if [ "${ARCH}" = "x86" ]; then
  SIMD_OBJECTS="vec_ops/vec_kernel_avx2.o vec_ops/vec_kernel_avx512.o"
  BUILD_SIMD_TIERS=1
fi

# SAY WHICH WAY IT WENT. Losing the SIMD tiers silently is the failure worth
# guarding against: they are the point of the package.
echo "configure: target architecture: ${ARCH}"
if [ "${BUILD_SIMD_TIERS}" = "1" ]; then
  echo "configure: building SIMD tiers: baseline, AVX2, AVX-512"
else
  echo "configure: building SIMD tiers: baseline only"
fi

# THE C++ MUST BE TOLD WHAT THE BUILD DECIDED. `IS_X86_TARGET` in vec_ops.hpp
# used to make its own, independent judgement from __x86_64__, so the two could
# disagree -- and when they did, the objects were absent while the references
# to them remained. Passing the decision through as a define makes disagreement
# impossible.
sed -e "s|@LOGMU_SIMD_OBJECTS@|${SIMD_OBJECTS}|" \
    -e "s|@LOGMU_BUILD_SIMD_TIERS@|${BUILD_SIMD_TIERS}|" \
    src/Makevars.in > src/Makevars

if [ "${ARCH}" = "x86" ]; then
  {
    printf '\n'
    printf 'vec_ops/vec_kernel_avx2.o: vec_ops/vec_kernel_avx2.cpp\n'
    printf '\t$(CXX) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) -mavx2 -mfma -c vec_ops/vec_kernel_avx2.cpp -o vec_ops/vec_kernel_avx2.o\n'
    printf '\n'
    printf 'vec_ops/vec_kernel_avx512.o: vec_ops/vec_kernel_avx512.cpp\n'
    printf '\t$(CXX) $(ALL_CPPFLAGS) $(ALL_CXXFLAGS) -mavx512f -mavx512cd -mavx512bw -mavx512dq -mavx512vl -c vec_ops/vec_kernel_avx512.cpp -o vec_ops/vec_kernel_avx512.o\n'
  } >> src/Makevars
fi

echo "configure: target arch = ${ARCH}; SIMD tiers = ${SIMD_OBJECTS:-baseline only}"
exit 0
